# Root compose defaults (safe for local self-host / dev)
# Copy to .env to override.
#
# This fork uses Supabase Cloud for storage and auth. The local Postgres
# container has been removed; the variables formerly named POSTGRES_* are
# gone too. If you need to switch back to local Postgres or Clerk auth,
# revert to upstream `abhi1693/openclaw-mission-control` master.

# --- app ports (host) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
REDIS_PORT=6379

# --- public URL of the backend (used in onboarding instructions etc.) ---
BASE_URL=http://localhost:8000
# Comma-separated origin allowlist; set to the exact public origin in prod.
CORS_ORIGINS=http://localhost:3000

# Boot-time DDL is dangerous against a shared (Supabase Cloud) database.
# Keep this off in production and run `alembic upgrade head` explicitly
# when applying migrations.
DB_AUTO_MIGRATE=false

LOG_LEVEL=INFO
REQUEST_LOG_SLOW_MS=1000

# --- auth ---
# Must be `supabase` for this fork's default path. Setting it to `local`
# or `clerk` still works (the code paths are intact) but you'd also need
# to restore the local Postgres service in compose.yml.
AUTH_MODE=supabase

# REQUIRED when AUTH_MODE=local (kept here for completeness).
LOCAL_AUTH_TOKEN=

# --- Supabase (REQUIRED for AUTH_MODE=supabase) ---
# Pooler URI — get from Project Settings → Database → Connection string → URI.
# Use the 6543 (pooler) port, not 5432.
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Project Settings → API
SUPABASE_URL=https://<ref>.supabase.co

# Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=

# Project Settings → API → Project API Keys → service_role
# Backend-only; do NOT expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Fernet-format secret for at-rest encryption of `gateways.token`.
# Generate with: openssl rand -base64 32
GATEWAY_TOKEN_ENCRYPTION_KEY=

# --- frontend (public; visible in the browser bundle) ---
# REQUIRED: Public URL used by the browser to reach the API.
# Use `auto` to target the same host currently serving Mission Control on port 8000.
NEXT_PUBLIC_API_URL=auto

# Mirror SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co

# Project Settings → API → Project API Keys → anon
NEXT_PUBLIC_SUPABASE_ANON_KEY=
